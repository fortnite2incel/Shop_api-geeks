# Django
SECRET=change-me-to-a-random-secret-key
DEBUG=True

# Database (Postgres, используется в docker-compose)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=shop_api
DB_USER=shop_api
DB_PASSWORD=shop_api
DB_HOST=db
DB_PORT=5432

# Redis (cache / celery broker & result backend)
REDIS_CACHE_URL=redis://redis:6379/11
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/3

# SMTP (используется Celery-задачами для отправки писем)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/users/google-login/
